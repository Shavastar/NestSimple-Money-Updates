+def process_started(pid):
+    """Windows process birth time identifies a process across PID reuse."""
+    if sys.platform!='win32':return None
+    import ctypes
+    from ctypes import wintypes as w
+    api=ctypes.WinDLL('kernel32',use_last_error=True)
+    api.OpenProcess.argtypes=[w.DWORD,w.BOOL,w.DWORD];api.OpenProcess.restype=w.HANDLE
+    api.GetProcessTimes.argtypes=[w.HANDLE,*([ctypes.POINTER(w.FILETIME)]*4)];api.GetProcessTimes.restype=w.BOOL
+    api.CloseHandle.argtypes=[w.HANDLE];api.CloseHandle.restype=w.BOOL
+    handle=api.OpenProcess(0x1000,False,pid)
+    if not handle:return None
+    try:
+        created,exited,kernel,user=(w.FILETIME() for _ in range(4))
+        if not api.GetProcessTimes(handle,ctypes.byref(created),ctypes.byref(exited),ctypes.byref(kernel),ctypes.byref(user)):return None
+        return ((created.dwHighDateTime<<32)|created.dwLowDateTime)/10000000-11644473600
+    finally:api.CloseHandle(handle)
+
+def session_alive(session):
+    if not alive(session['pid']):return False
+    started=process_started(session['pid']);expected=session.get('started')
+    return started is None or expected is None or abs(started-expected)<0.01
+
