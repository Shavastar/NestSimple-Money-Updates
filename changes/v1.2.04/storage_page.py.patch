+def storage_snapshot(program,data,backup=None):
+    program=Path(program).resolve();data=Path(data).resolve()
+    database=data/'finances.sqlite3'
+    database_bytes=sum(p.stat().st_size for p in (database,Path(str(database)+'-wal'),Path(str(database)+'-shm')) if p.is_file())
+    drives={}
+    for purpose,path in [('Application',program),('Household',data)]+([('Backups',Path(backup).resolve())] if backup else []):
+        existing=path
+        while not existing.exists() and existing!=existing.parent:existing=existing.parent
+        key=existing.anchor.casefold()
+        if key in drives:drives[key]['purposes'].append(purpose);continue
+        try:
+            usage=shutil.disk_usage(existing)
+            drives[key]=dict(drive=existing.anchor,purposes=[purpose],total=usage.total,used=usage.used,free=usage.free)
+        except OSError:drives[key]=dict(drive=existing.anchor,purposes=[purpose],error='Unavailable')
+    return dict(program=str(program),data=str(data),application_bytes=folder_bytes(program),household_bytes=folder_bytes(data),database_bytes=database_bytes,drives=list(drives.values()))
