+def review_sort_key(row,column,actuals):
+    from decimal import Decimal
+    if column==0:return tr(row[0]).casefold()
+    if column==1:return approval_sort_key(row,1)
+    if column==2:return Decimal(actuals[row[0]])/100 if row[0] in actuals else None
+    if column==3:return approval_sort_key(row,2)
+    return approval_sort_key(row,2)-approval_sort_key(row,1)
+
+def sorted_review_rows(rows,column,reverse,actuals):
+    present=[r for r in rows if review_sort_key(r,column,actuals) is not None]
+    missing=[r for r in rows if review_sort_key(r,column,actuals) is None]
+    return sorted(present,key=lambda r:review_sort_key(r,column,actuals),reverse=reverse)+missing
+
